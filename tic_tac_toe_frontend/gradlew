#!/usr/bin/env bash
# Stub Gradle wrapper for CI/mobile code analysis run from tic_tac_toe_frontend.
# The Android project is not initialized in this template; this script
# allows tooling that invokes ./gradlew to succeed without performing
# any real Android build or Gradle task.

echo "Stub gradlew (tic_tac_toe_frontend): Android project is not initialized; skipping Gradle tasks: $*"
exit 0
